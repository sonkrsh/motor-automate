# TP-Link Cloud Configuration
TPLINK_HOST=aps1-app-server.iot.i.tplinkcloud.com
THING_ID=your-tapo-thing-id
AUTHORIZATION=your-authorization-token
APP_CID=your-app-cid
USER_AGENT=TP-Link_Tapo_Android/3.18.506(sdk_gphone64_arm64;Android 12)
X_APP_NAME=TP-Link_Tapo_Android
X_APP_VERSION=3.18.506
X_LOCALE=en_US
X_NET_TYPE=wifi
X_OSPF=Android 12
X_STRICT=0
X_TERM_ID=your-term-id

# Monitoring Settings
MONITOR_FAST_INTERVAL_SEC=180
MONITOR_SLOW_INTERVAL_SEC=900
VOLTAGE_MIN_THRESHOLD=10
VOLTAGE_MAX_THRESHOLD=400
