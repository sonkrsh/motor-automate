# TP-Link Cloud Configuration
TPLINK_HOST=aps1-app-server.iot.i.tplinkcloud.com
TPLINK_AUTH_HOST=wap.tplinkcloud.com
# Optional: Provide email & password for automatic cloud login / token refresh on 401
# TPLINK_EMAIL=your-email@example.com
# TPLINK_PASSWORD=your-password
THING_ID=your-tapo-thing-id
AUTHORIZATION=ut|your-authorization-token
APP_CID=your-app-cid
USER_AGENT=TP-Link_Tapo_Android/3.18.506(sdk_gphone64_arm64;Android 12)
X_APP_NAME=TP-Link_Tapo_Android
X_APP_VERSION=3.18.506
X_LOCALE=en_US
X_NET_TYPE=wifi
X_OSPF=Android 12
X_STRICT=0
X_TERM_ID=your-term-id

# Monitoring Settings
# A reading is "abnormal" when VOLTAGE_MIN < reading < VOLTAGE_MAX
VOLTAGE_MIN_THRESHOLD=10
VOLTAGE_MAX_THRESHOLD=400
# Polling session: read every POLL_INTERVAL_SEC, keep VOLTAGE_WINDOW_SIZE readings.
# Motor shuts off only if a full window (10s x 18 = ~3 min) is all abnormal.
POLL_INTERVAL_SEC=10
VOLTAGE_WINDOW_SIZE=18

# Bucket: cumulative motor runtime (hours) while voltage > VOLTAGE_MAX.
# Motor shuts off when bucket_progress >= BUCKET_SIZE (Condition 2).
BUCKET_SIZE=2
# Automatic daily bucket reset time (local 24h clock)
BUCKET_RESET_HOUR=11
BUCKET_RESET_MINUTE=0
BUCKET_STATE_FILE=bucket_state.json
